# Switches the platform from the builtin identity provider to Keycloak. Copy
# to dev/oidc.env: the file is optional, without it the stand keeps the
# builtin provider and the demo users.
#
# The redirect URIs of the client cannot be configured, the web builds them
# from the address of the page it runs on. Register in Keycloak, for every
# address the platform is served at:
#
#   <OC_URL>/oidc-callback.html         valid redirect URI
#   <OC_URL>/oidc-silent-redirect.html  valid redirect URI
#   <OC_URL>/                           valid post logout redirect URI
#   <OC_URL>                            web origin
#
# The client is public, with the standard flow and PKCE.

OC_OIDC_ISSUER=https://idp.example.com/realms/example
WEB_OIDC_CLIENT_ID=opencloud-web

# The account is created at the first login, from the claims of the token.
PROXY_AUTOPROVISION_ACCOUNTS=true

# One claim carries the client roles of the token and serves twice: it picks
# the role of the user, and it becomes the groups of the user. The name has
# to match the token claim name of the mapper in Keycloak.
#
# The role decides what the user may do at all; the mapping itself is in
# opencloud/role-mapping.yaml, the proxy reads it from a file only. A user whose
# token carries none of the mapped roles is refused every request, but the
# account is created before the role is resolved: such accounts stay empty
# and have to be removed by hand.
#
# The groups decide what the user reaches: the platform creates the ones it
# does not know and grants nothing by itself, the administrator gives a group
# its role on a space. The claim is authoritative, a membership missing from
# it is taken away at the next login.
PROXY_ROLE_ASSIGNMENT_DRIVER=oidc
PROXY_ROLE_ASSIGNMENT_OIDC_CLAIM=roles
PROXY_AUTOPROVISION_CLAIM_GROUPS=roles
# Otherwise every new account first gets the role user from the graph service
# and the proxy replaces it a moment later; the claim is the only source.
GRAPH_ASSIGN_DEFAULT_USER_ROLE=false

# Basic auth cannot stay on next to autoprovisioning: the platform builds the
# claims of such a request without 'name' and every request of that user then
# fails while it updates the account. Impersonation goes with it, the scripts
# ask Keycloak for a token of the user instead (dev/scripts/token.sh).
PROXY_ENABLE_BASIC_AUTH=false
AUTH_APP_ENABLE_IMPERSONATION=false

# The page of the web may reach the identity provider: the default policy of
# the proxy allows the instance itself and nothing else. opencloud/csp.yaml
# names the provider, the proxy merges it into the default. Put the same
# issuer there.
PROXY_CSP_CONFIG_FILE_LOCATION=/etc/opencloud/csp.yaml

# The builtin provider is not needed any more. The proxy answers
# /.well-known/openid-configuration with the external one, which is how the
# desktop and the mobile clients discover it.
OC_EXCLUDE_RUN_SERVICES=idp
PROXY_OIDC_REWRITE_WELLKNOWN=true

# In production also turn IDM_CREATE_DEMO_USERS off in docker-compose.yml.
