# Copy to dev/.env and fill in. Nothing here has a safe default secret.

# --- Platform ------------------------------------------------------------
# Pinning the tag is mandatory: the event structures and the proxy routes are
# an internal API and change between releases. The releases land in the
# opencloud-rolling repository first; opencloudeu/opencloud still serves 7.2.4,
# whose proxy route list already differs from 8.0.1.
OC_DOCKER_IMAGE=opencloudeu/opencloud-rolling
OC_DOCKER_TAG=8.0.1
OC_URL=https://localhost:9200
OC_LOG_LEVEL=info
ADMIN_PASSWORD=admin
# Keycloak instead of the builtin provider: copy dev/oidc.env.example to
# dev/oidc.env. Without that file the builtin one and the demo users stay.

# --- Extensions ----------------------------------------------------------
EXTENSIONS_LOG_LEVEL=debug
VIDEO_THUMBNAILS_WORKERS=2
# Previews the platform generates at once for what video-thumbnails passes on.
VIDEO_THUMBNAILS_PLATFORM_GENERATIONS=2
FILE_ACTIVITY_MAX_AGE=2160h
# Comma separated user names allowed to read the feed; empty means everyone.
FILE_ACTIVITY_ALLOWED_USERS=
# Comma separated user names that read every space; the rest read their own.
FILE_ACTIVITY_FULL_FEED_USERS=
# Push of the feed; empty URL disables it.
FILE_ACTIVITY_WEBHOOK_URL=
FILE_ACTIVITY_WEBHOOK_SECRET=

# The same pair is given to the platform and to both extensions.
SERVICE_ACCOUNT_ID=opencloud-extensions
SERVICE_ACCOUNT_SECRET=change-me

# --- S3 (minio on the stand, Yandex Object Storage later) ----------------
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-too
S3_REGION=default
S3_BLOBS_BUCKET=opencloud-blobs
S3_THUMBS_BUCKET=video-thumbnails
# The copy of the tree file-activity keeps for restore.
S3_TREE_BUCKET=file-activity-tree

# The images of minio on Docker Hub are not public any more.
MINIO_IMAGE=quay.io/minio/minio
MC_IMAGE=quay.io/minio/mc
MINIO_TAG=latest
MC_TAG=latest
